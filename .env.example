# ZenZebra CRM — environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ─── Canonical database (required) ──────────────────────────────────────────
# Neon Postgres connection string. Everything the dashboard reads comes from here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Odoo 19 Enterprise SaaS (required for live ingestion) ──────────────────
# Odoo's native "Send Webhook Notification" action posts only {"_model","_id"},
# so the webhook must read the record back over JSON-RPC. Without these four the
# endpoint cannot hydrate a notification and every delivery fails.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=integration-user@example.com
ODOO_PASSWORD=

# Shared secret sent by Odoo as the `x-webhook-secret` header.
# The webhook FAILS CLOSED without this: unset means every delivery is rejected.
# Generate with: openssl rand -hex 32
ODOO_WEBHOOK_SECRET=

# Local development only. Skips webhook authentication entirely.
# Never set this in a deployed environment.
# ODOO_WEBHOOK_ALLOW_INSECURE=true

# ─── Scheduled reconciliation pull ──────────────────────────────────────────
# Vercel Cron authenticates as `Authorization: Bearer $CRON_SECRET` and cannot
# send custom headers, so /api/admin/odoo-sync accepts this in addition to
# ODOO_WEBHOOK_SECRET. Set it in the Vercel project settings.
# Note: the Hobby plan permits one cron run per day, which makes the scheduled
# pull a safety net rather than a real-time fallback — webhooks are the live path.
CRON_SECRET=
