# ZenZebra CRM — environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ─── Canonical database (required) ──────────────────────────────────────────
# Neon Postgres connection string. Everything the dashboard reads comes from here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Odoo 19 Enterprise SaaS (required for live ingestion) ──────────────────
# Odoo's native "Send Webhook Notification" action posts only {"_model","_id"},
# so the webhook must read the record back over JSON-RPC. Without these four the
# endpoint cannot hydrate a notification and every delivery fails.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=integration-user@example.com
ODOO_PASSWORD=

# Shared secret sent by Odoo as the `x-webhook-secret` header.
# The webhook FAILS CLOSED without this: unset means every delivery is rejected.
# Generate with: openssl rand -hex 32
ODOO_WEBHOOK_SECRET=

# Local development only. Skips webhook authentication entirely.
# Never set this in a deployed environment.
# ODOO_WEBHOOK_ALLOW_INSECURE=true

# ─── Reconciliation pull (PRIMARY ingestion path) ───────────────────────────
# An external scheduler calls /api/admin/odoo-sync every few minutes with
# `Authorization: Bearer $CRON_SECRET`. This is how sales reach the dashboard.
#
# It is a pull, not a push, on purpose: every run re-covers everything since the
# stored cursor, so a missed run or an outage self-heals on the next tick.
# Vercel's own cron is capped at one run per day on Hobby, hence the external
# scheduler. Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Reconciliation pull cadence ────────────────────────────────────────────
# How often the external scheduler calls /api/admin/odoo-sync, in minutes.
# The dashboard uses this to decide when a sync is "late", so it must match the
# scheduler's actual interval or the status badge will be wrong.
SYNC_INTERVAL_MINUTES=5
