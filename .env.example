# ZenZebra CRM — environment configuration
# Copy to .env.local and fill in. Never commit real values.

# ─── Canonical database (required) ──────────────────────────────────────────
# Neon Postgres connection string. Everything the dashboard reads comes from here.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Odoo 19 Enterprise SaaS (required for live ingestion) ──────────────────
# Odoo's native "Send Webhook Notification" action posts only {"_model","_id"},
# so the webhook must read the record back over JSON-RPC. Without these four the
# endpoint cannot hydrate a notification and every delivery fails.
ODOO_URL=https://your-instance.odoo.com
ODOO_DB=your-database-name
ODOO_USERNAME=integration-user@example.com
ODOO_PASSWORD=

# Shared secret guarding the webhook endpoint. REQUIRED — the endpoint fails
# closed, so leaving this unset rejects every delivery.
#
# Odoo's webhook action has no field for request headers, so the secret travels
# as the last path segment of the URL configured in Odoo (the same pattern Slack
# uses for incoming webhooks):
#
#   https://<your-domain>/api/webhooks/odoo/<ODOO_WEBHOOK_SECRET>
#
# This value must match that final segment EXACTLY. Rotate by changing both.
# Generate with: openssl rand -hex 32
ODOO_WEBHOOK_SECRET=

# Local development only. Skips webhook authentication entirely.
# Never set this in a deployed environment.
# ODOO_WEBHOOK_ALLOW_INSECURE=true

# ─── Reconciliation pull (safety net behind the webhook) ────────────────────
# An external scheduler calls /api/admin/odoo-sync every few minutes with
# `Authorization: Bearer $CRON_SECRET`.
#
# Webhooks carry the live traffic; this recovers anything they miss. Every run
# re-covers everything since the stored cursor, so a delivery lost to a deploy or
# an outage is picked up automatically instead of disappearing.
# Vercel's own cron is capped at one run per day on Hobby, hence the external
# scheduler. Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Cadence and service level ──────────────────────────────────────────────
# How often the external scheduler calls /api/admin/odoo-sync, in minutes. The
# dashboard uses this to decide when reconciliation is "late", so it must match
# the scheduler's actual interval or the status badge will be wrong.
SYNC_INTERVAL_MINUTES=5

# Budget for a sale to become visible, in seconds. Deliberately well below the
# poll interval: a webhook lands in ~1s, so anything slower means the webhook was
# missed and the fallback recovered it. The on-time rate is therefore a direct
# measure of whether real-time delivery is working.
SLA_TARGET_SECONDS=30

# ─── Realtime push to the browser (optional) ────────────────────────────────
# Ably delivers "new sale ingested" notifications so open dashboards refresh
# within about a second instead of waiting for their next fetch.
#
# Server-side only — never expose this to the browser. Clients call
# /api/realtime/token (session-authenticated) and receive a short-lived,
# subscribe-only token scoped to the dashboard:* channels.
#
# Leave unset to disable realtime entirely: ingestion is unaffected and
# dashboards behave exactly as before.
ABLY_API_KEY=
